---
import SiteLayout from '../layouts/SiteLayout.astro';
import { getDocs } from '../lib/docs';
import { withBase } from '../lib/paths';

const docs = await getDocs();
const featuredDocs = docs.filter((doc) =>
  ['user-guide', 'installation', 'reader-features', 'webserver'].includes(doc.slug)
);
---

<SiteLayout
  title="CrossDiTo"
  description="Focused open-source e-reader firmware for the Xteink X4 Pro."
  pageClass="home"
>
  <section slot="hero" class="hero">
    <div class="hero-copy">
      <p class="eyebrow">An X4 Pro-only fork of <a href="https://github.com/uxjulia/CrossInk">CrossInk 1.5.0</a></p>
      <h1>Cross<span class="crossdito-serif">DiTo</span></h1>
      <p class="hero-text">
        A personal test build based directly on CrossInk 1.5.0. The base firmware is upstream work; this site highlights only CrossDiTo's faster cached EPUBs, lower idle power, finer low-light control, background full-book pagination, and hardware-verified e-ink refresh fixes.
      </p>
      <div class="hero-actions">
        <a class="button primary" href={withBase('installation.html')}>Installation Instructions</a>
        <a class="button" href={withBase('releases/v1.5.1.html')}>What's different</a>
      </div>
    </div>
    <img
      src={withBase('images/bitter-small-15-margin.jpg')}
      alt="CrossDiTo typography preview"
      class="hero-image"
      loading="eager"
    />
  </section>

  <section class="section-heading">
    <p class="eyebrow">Start here</p>
    <h2>Useful docs</h2>
  </section>
  <nav class="useful-docs" aria-label="Useful documentation">
    {
      featuredDocs.map((doc) => (
        <a href={doc.url}>
          <span>{doc.title}</span>
        </a>
      ))
    }
  </nav>
</SiteLayout>
